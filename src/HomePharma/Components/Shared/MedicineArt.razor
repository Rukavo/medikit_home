<svg width="58" height="58" viewBox="0 0 64 64" fill="none" aria-hidden="true" class="medicine-art" style="--pack:@Colour;--pack-light:@Light">
    <ellipse cx="32" cy="57" rx="25" ry="4" fill="#204e6c" opacity=".09"/>
    <path d="M10 14 44 8 55 16 21 23Z" fill="#fff" stroke="#244f69" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="m10 14 11 9v33l-11-9Z" fill="var(--pack-light)" stroke="#244f69" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="m21 23 34-7v33l-34 7Z" fill="#fffefa" stroke="#244f69" stroke-width="1.8" stroke-linejoin="round"/>
    <path d="m22 24 32-6v9l-32 6Z" fill="var(--pack)"/>
    <path d="m11 16 9 7v9l-9-7Z" fill="var(--pack)" opacity=".7"/>
    <path d="m23 49 30-6v5l-30 6Z" fill="var(--pack-light)"/>
    @if (Variant == 1)
    {
        <g transform="translate(38 38) rotate(-35)"><rect x="-9" y="-4.5" width="18" height="9" rx="4.5" fill="var(--pack)" stroke="#244f69" stroke-width="1.5"/><path d="M0-4v8h-4a4 4 0 0 1 0-8Z" fill="white"/><path d="M0-4v8" stroke="#244f69" stroke-width="1.2"/></g>
    }
    else if (Variant == 2)
    {
        <circle cx="38" cy="38" r="8" fill="var(--pack-light)" stroke="var(--pack)" stroke-width="2"/><path d="m33 43 10-10" stroke="var(--pack)" stroke-width="2.5"/>
    }
    else
    {
        <circle cx="38" cy="38" r="8.5" fill="var(--pack)"/><path d="M38 33v10m-5-5h10" stroke="white" stroke-width="3"/>
    }
</svg>
@code {
    [Parameter] public string Name { get; set; } = "";
    private int Variant => Name.Aggregate(0, (value, c) => (value + c) % 4);
    private string Colour => new[] { "#5ba3d0", "#e8b04e", "#69b7bc", "#9991cd" }[Variant];
    private string Light => new[] { "#d9edf8", "#fce9c4", "#d9f0ee", "#eae5fa" }[Variant];
}
